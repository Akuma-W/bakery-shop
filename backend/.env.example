PORT=3001
NODE_ENV=development

# Database connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bakery_db?schema=public"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:3000"

# JWT configuration (to be used in auth milestone)
JWT_ACCESS_SECRET="dev_access_secret_key_change_in_production"
JWT_REFRESH_SECRET="dev_refresh_secret_key_change_in_production"

# PayOS Sandbox credentials (to be used in payments milestone)
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
